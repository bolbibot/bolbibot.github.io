# ===== Обязательное =====
# Токен бота от @BotFather
BOT_TOKEN=
# api_id и api_hash с https://my.telegram.org (раздел API development tools) — для отправки файлов до 2 ГБ
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=

# ===== Тарифы и лимиты (можно не трогать) =====
FREE_PER_DAY=1
PRICE_P10_STARS=25
PRICE_P10_RUB=49
PRICE_P50_STARS=100
PRICE_P50_RUB=199
PRICE_UNLIM30_STARS=150
PRICE_UNLIM30_RUB=299
# Максимальная длительность ролика, секунды
MAX_DURATION=10800
# Максимальный размер файла, байты
MAX_FILESIZE=2000000000
# Сколько видео скачивать одновременно
PARALLEL=3

# ===== Продвижение =====
# Куда ведёт кнопка BolBiBot
BOLBIBOT_URL=https://bolbibot.github.io/
# Канал, подписка на который нужна для бесплатных скачиваний (например @mychannel).
# Бот должен быть администратором канала. Пусто — проверка выключена
REQUIRED_CHANNEL=

# ===== Сайты и обход блокировок =====
# Разрешённые сайты через запятую. Пусто — список по умолчанию
ALLOWED_HOSTS=
# Прокси для всех сайтов и отдельно для сайта (PROXY_YOUTUBE, PROXY_VK, PROXY_RUTUBE…)
# Формат: http://user:pass@host:port или socks5://user:pass@host:port
PROXY_DEFAULT=
PROXY_YOUTUBE=
# Файл cookies аккаунта YouTube в формате Netscape (путь внутри контейнера, например /app/data/youtube.txt)
YOUTUBE_COOKIES=

# ===== Оплата картой через Robokassa (по умолчанию выключена) =====
ROBOKASSA_ENABLED=0
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=
# 1 — тестовый режим (использовать тестовые пароли из кабинета)
ROBOKASSA_TEST=0
# Алгоритм подписи, как в настройках магазина: md5, sha256 или sha512
ROBOKASSA_ALGO=md5
# 1 — передавать номенклатуру для чека
ROBOKASSA_RECEIPT=0
# Домен, направленный на сервер (для HTTPS-адреса уведомлений)
DOMAIN=
